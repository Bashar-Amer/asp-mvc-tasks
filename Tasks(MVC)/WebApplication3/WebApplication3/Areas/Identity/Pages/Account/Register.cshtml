@page
@using WebApplication3.Areas.Identity.Pages.Account
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .register-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .register-card {
        background-color: #ffffff;
        border: 2px solid #3b5d50;
        border-radius: 28px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    }

        .register-card h1 {
            text-align: center;
            color: #3b5d50;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }

        .register-card .form-floating {
            margin-bottom: 1rem;
        }

        .register-card .form-control {
            border: 1.5px solid #3b5d50;
            border-radius: 12px;
        }

            .register-card .form-control:focus {
                border-color: #3b5d50;
                box-shadow: 0 0 0 0.25rem rgba(59, 93, 80, 0.25);
            }

        .register-card .btn-primary-custom {
            background-color: #3b5d50;
            color: #ffffff;
            border: 2px solid #3b5d50;
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            width: 100%;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
            margin-top: 0.5rem;
        }

            .register-card .btn-primary-custom:hover {
                background-color: #2e493f;
                border-color: #2e493f;
                color: #ffffff;
            }

        .register-card .login-link {
            text-align: center;
            margin-top: 1.5rem;
            margin-bottom: 0;
            color: #555555;
        }

            .register-card .login-link a {
                text-decoration: none;
                color: #3b5d50;
                font-weight: bold;
            }

                .register-card .login-link a:hover {
                    text-decoration: underline;
                }
</style>

<div class="register-wrapper">
    <div class="register-card">
        <h1>Create New Account</h1> 

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input type="password" asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input type="password" asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input type="number" asp-for="Input.Age" class="form-control" aria-required="true" />
                <label asp-for="Input.Age">Age</label>
                <span asp-validation-for="Input.Age" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary-custom btn-lg">Register</button>

            <p class="login-link">
                Have already an account? <a asp-page="./Login">Login</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}