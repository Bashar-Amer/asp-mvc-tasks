@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .login-card {
        background-color: #ffffff;
        border: 2px solid #3b5d50;
        border-radius: 28px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    }

        .login-card h1 {
            text-align: center;
            color: #3b5d50;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
        }

        .login-card .form-floating {
            margin-bottom: 1rem;
        }

        .login-card .form-control {
            border: 1.5px solid #3b5d50;
            border-radius: 12px;
        }

            .login-card .form-control:focus {
                border-color: #3b5d50;
                box-shadow: 0 0 0 0.25rem rgba(59, 93, 80, 0.25);
            }

        .login-card .form-check {
            margin-bottom: 1.25rem;
            padding-left: 1.75rem;
        }

        .login-card .form-check-input {
            border: 1.5px solid #3b5d50;
        }

            .login-card .form-check-input:checked {
                background-color: #3b5d50;
                border-color: #3b5d50;
            }

        .login-card .form-check-label {
            color: #3b5d50;
            font-weight: 600;
        }

        .login-card .btn-primary-custom {
            background-color: #3b5d50;
            color: #ffffff;
            border: 2px solid #3b5d50;
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            width: 100%;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
            margin-top: 0.5rem;
        }

            .login-card .btn-primary-custom:hover {
                background-color: #2e493f;
                border-color: #2e493f;
                color: #ffffff;
            }

        .login-card .account-links {
            text-align: center;
            margin-top: 1.5rem;
            margin-bottom: 0;
            color: #555555;
        }

            .login-card .account-links a {
                text-decoration: none;
                color: #3b5d50;
                font-weight: bold;
            }

                .login-card .account-links a:hover {
                    text-decoration: underline;
                }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <h1>Log In</h1>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="Email" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary-custom btn-lg">Log in</button>

            <p class="account-links">
                Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}