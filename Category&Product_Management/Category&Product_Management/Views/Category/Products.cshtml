@model ICollection<Product>

@{
    ViewData["Title"] = "Products";
}

<h1 class="text-center text-primary">Products</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 my-5">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="/images/@product.ImagePath" class="card-img-top" alt="@product.Name image" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title mb-3">@product.Name</h5>
                    <a class="btn btn-primary mt-auto" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">View details</a>
                </div>
            </div>
        </div>
    }
</div>






